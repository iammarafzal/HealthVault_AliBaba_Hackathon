# ==============================================================================
# HealthVault AI — Git Ignore Rules
# ==============================================================================

# ── Python & Bytecode ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Environment Variables & Secrets ──────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example

# ── Testing & Code Coverage ──────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# ── Logs & Local Databases ───────────────────────────────────────────────────
*.log
logs/
*.sqlite
*.sqlite3
*.db

# ── Uploads & Temporary Media ────────────────────────────────────────────────
uploads/*
!uploads/.gitkeep
!uploads/**/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/**/.gitkeep
storage/
tmp/
temp/
media/

# ── IDEs, Editors & OS Files ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Frontend (Next.js & Node.js) ─────────────────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# ── Stitch Mockups & Generated Scratch Artifacts ──────────────────────────────
stitch_screens/
frontend/stitch_designs/
