# HealthVault AI — Backend Production Environment Template (Render + Supabase)
ENVIRONMENT=production
PORT=10000

# Supabase PostgreSQL Connection String (Transaction Pooler / Direct)
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Cryptographic Keys (Min 32 characters)
SECRET_KEY=change-this-to-a-super-secret-random-32-character-key
JWT_SECRET_KEY=change-this-to-a-super-secret-random-32-character-jwt-key

# Vercel Frontend Domain URL
FRONTEND_URL=https://[YOUR-PROJECT].vercel.app
ALLOWED_ORIGINS=https://[YOUR-PROJECT].vercel.app

# External AI Provider Keys
DASHSCOPE_API_KEY=[Alibaba-API-Key]
GEMINI_API_KEY=[Google-AI-Key]

# Supabase Private Storage & Signed URL Configuration (Optional: defaults to local disk if omitted)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=prescriptions
