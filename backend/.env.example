# HealthVault AI — Environment Variables
# Copy to .env and fill in real values

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/healthvault

# Local File Storage
UPLOAD_DIR=uploads
SERVER_BASE_URL=http://localhost:8000

# Authentication
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Feature Flags
USE_MOCK=False

# OCR Settings
OCR_USE_GPU=False
OCR_LANG=en

# ----------------------------------------------------------------------
# Pluggable LLM Provider Configuration
# Switch between "dashscope" (Qwen), "gemini" (Google), or "mock"
# ----------------------------------------------------------------------
LLM_PROVIDER=dashscope

# Alibaba Cloud — DashScope (Qwen Models: qwen-plus, qwen-max, qwen-turbo)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL_NAME=qwen-plus

# Google AI Studio — Gemini Models (gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# Alibaba Cloud — Object Storage Service
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
