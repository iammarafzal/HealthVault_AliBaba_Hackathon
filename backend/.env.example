# ==============================================================================
# HealthVault AI — Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` inside the `backend/` directory:
#    cp .env.example .env
# 2. Populate the required API keys and configuration values below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="HealthVault AI"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SERVER_BASE_URL="http://localhost:8000"

# CORS Origins (Comma-separated list or JSON array of allowed frontend URLs)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000"

# ------------------------------------------------------------------------------
# 2. Database & Persistence (PostgreSQL with AsyncPG)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/healthvault"

# Local Static Upload Directory
UPLOAD_DIR="uploads"

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Generate a secure 256-bit random key: openssl rand -hex 32
SECRET_KEY="change-this-to-a-super-secret-random-32-character-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. Feature Flags & Latency Settings
# ------------------------------------------------------------------------------
# Set to True for offline/standalone demo mode with mocked responses (no external API calls)
USE_MOCK=False

# Maximum wait time for external LLM API calls before triggering fallback (seconds)
LLM_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 5. Document OCR Engine (PaddleOCR)
# ------------------------------------------------------------------------------
# PaddleOCR runs locally — no API key required.
OCR_USE_GPU=False
OCR_LANG="en"

# ------------------------------------------------------------------------------
# 6. Pluggable Text LLM Engine (Summaries, Interactions, Voice Intent)
# ------------------------------------------------------------------------------
# Options for LLM_PROVIDER: "dashscope" | "qwen" | "gemini" | "google" | "mock"
LLM_PROVIDER="dashscope"
# Explicit model name override (optional, defaults to provider default if empty)
LLM_MODEL_NAME=

# Alibaba Cloud DashScope (Qwen Text Models: qwen-plus, qwen-max, qwen-turbo)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL_NAME="qwen-plus"

# Google AI Studio (Gemini Models: gemini-1.5-flash, gemini-2.0-flash, gemini-3.1-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME="gemini-3.1-flash-lite"

# ------------------------------------------------------------------------------
# 7. Pluggable Multimodal Vision LLM Engine (Prescription & Lab OCR Extraction)
# ------------------------------------------------------------------------------
# Options for VISION_PROVIDER: "gemini" | "qwen" | "openai" | "groq" | "mock"
VISION_PROVIDER="gemini"
VISION_MODEL="gemini-3.1-flash-lite"

# OpenAI Vision Models (gpt-4o, gpt-4o-mini) — optional
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 8. Urdu Voice Recognition (Groq Whisper ASR)
# ------------------------------------------------------------------------------
# Groq Cloud API Key for ultra-fast Urdu speech-to-text audio transcription
GROQ_API_KEY=your_groq_api_key_here
GROQ_ASR_MODEL="whisper-large-v3"

# ------------------------------------------------------------------------------
# 9. Cloud Storage (Alibaba Cloud OSS) — Optional / Production
# ------------------------------------------------------------------------------
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET_NAME=your_oss_bucket_name
OSS_ENDPOINT="https://oss-ap-southeast-1.aliyuncs.com"

# ------------------------------------------------------------------------------
# 10. Web Push Notifications (VAPID) & Background Scheduler
# ------------------------------------------------------------------------------
# Base URL of frontend client (used in push notification click-through URLs and CORS)
FRONTEND_URL="http://localhost:3000"

# VAPID Keys for Web Push Notifications (ECC NIST P-256 key pair)
VAPID_PUBLIC_KEY="BCJEKWTCSiQeMeh0NIMvZvSu6w7skTcAMtQbACSLrETCXNaMMC2O8nXsuWMfgsLIPt-sYAcUphKS1yf7565YJ1Q"
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgZC3K3rjPVBk9DWMv\nZKfUAl5WdP+Ebho2q0My2OiJwPuhRANCAAQiRClkwkokHjHodDSDL2b0rusO7JE3\nADLUGwAki6xEwlzWjDAtjvJ17LljH4LCyD7frGAHFKYSktcn++euWCdU\n-----END PRIVATE KEY-----\n"
VAPID_CLAIM_EMAIL="mailto:admin@healthvault.local"

# APScheduler interval for dose reminders & notification polling (in minutes)
NOTIFICATION_CHECK_INTERVAL_MINUTES=5
