# HealthVault AI — Environment Variables
# Copy to .env and fill in real values

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/healthvault

# Authentication
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Alibaba Cloud — DashScope (Qwen Models)
DASHSCOPE_API_KEY=

# Alibaba Cloud — Object Storage Service
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=

# Feature Flags
USE_MOCK=False
